<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <!-- Cormorant Garamond Bold (OFL, Fonts/OFL-CormorantGaramond.txt), the serif chosen for Beta1 (28 Oct, set B).
       Bold here, not SemiBold : sentences are drawn small (TextSize.Story 0.92, StorySmall 0.8) and SemiBold read thin.
       The file lives in Content/Fonts, so the game builds the same on every machine and can be sold with it. -->
  <Asset Type="Graphics:FontDescription">
    <FontName>Fonts/CormorantGaramond-Bold.ttf</FontName>
    <Size>14</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
