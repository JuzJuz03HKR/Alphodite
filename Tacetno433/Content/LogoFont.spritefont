<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <!-- Cormorant Garamond SemiBold (OFL, Fonts/OFL-CormorantGaramond.txt), the serif chosen for Beta1 (28 Oct, set B).
       The file lives in Content/Fonts, so the game builds the same on every machine and can be sold with it. -->
  <Asset Type="Graphics:FontDescription">
    <FontName>Fonts/CormorantGaramond-SemiBold.ttf</FontName>
    <Size>80</Size>
    <Spacing>4</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
