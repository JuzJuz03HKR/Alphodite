<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <!-- THAI (Beta1 2 Nov, block F3) : Chakra Petch Medium (OFL, Fonts/OFL-ChakraPetch.txt, Cadson Demak / The Chakra Petch Project Authors), the Thai partner of MainFont (Saira Semi Condensed) (Core/ThaiText.cs).
       The user picked Trirong + Chakra Petch for Thai on 28 Oct. It holds English too, so a line with Thai in it is drawn
       wholly with this font.
       SHARP SCREEN twin : the same letters drawn 1.5x bigger, see Core/SharpText.cs. Change the Size of all four together. -->
  <Asset Type="Graphics:FontDescription">
    <FontName>Fonts/ChakraPetch-Medium.ttf</FontName>
    <Size>28.5</Size>
    <Spacing>1</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#3585;</Start>
        <End>&#3642;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#3647;</Start>
        <End>&#3675;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
