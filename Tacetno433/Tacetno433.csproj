<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <!-- Beta1 : the battle page's pixel art is read straight from these files (Core/FrameArt.cs), no Content.mgcb entry needed -->
  <ItemGroup>
    <None Include="Content\Art\Battle\**\*.png;Content\Art\Battle\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Beta1 screens : the pixel art of the other pages is read the same way (Core/UiArt.cs, docs/UI_ART_PLAN.md) -->
  <ItemGroup>
    <None Include="Content\Art\Ui\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Beta1 screens : the fonts are free (SIL Open Font License), their licence texts travel with the game -->
  <ItemGroup>
    <None Include="Content\Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>
</Project>