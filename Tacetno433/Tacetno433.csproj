<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <!-- Beta1 : the battle page's pixel art is read straight from these files (Core/FrameArt.cs), no Content.mgcb entry needed -->
  <ItemGroup>
    <None Include="Content\Art\Battle\**\*.png;Content\Art\Battle\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Beta1 screens : the pixel art of the other pages is read the same way (Core/UiArt.cs, docs/UI_ART_PLAN.md) -->
  <ItemGroup>
    <None Include="Content\Art\Ui\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Block C (2 Nov) : the conductors' paintings, the only art the team draws now, are read the same way (Core/ArtBank.cs) -->
  <ItemGroup>
    <None Include="Content\Art\Conductors\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Block E (2 Nov) : every sound and track is read straight from these folders (Audio/SoundBank.cs), no Content.mgcb entry
       needed. Borrowed holds the playtest's borrowed files : git keeps only its README (.gitignore), docs/CREDITS.md -->
  <ItemGroup>
    <None Include="Content\Audio\Sfx\*.wav;Content\Audio\Music\*.ogg;Content\Audio\Borrowed\*.wav;Content\Audio\Borrowed\*.ogg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Beta1 screens : the fonts are free (SIL Open Font License), their licence texts travel with the game -->
  <ItemGroup>
    <None Include="Content\Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- THAI TEXT (block F3, 2 Nov) : the Thai word list, read straight from the folder (Data/Lang.cs) -->
    <None Include="Content\Text\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>
</Project>