digraph Heap {
  graph [rankdir=TB, fontname="Sarabun", nodesep=0.18, ranksep=0.45, bgcolor="transparent"];
  node  [fontname="Sarabun", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#222222", margin="0.08,0.04"];
  edge  [color="#444444", arrowhead=none];

  n0 [label="[0] ANNA\n(0, 0, 0)", fillcolor="#e0e0e0", penwidth=1.6];
  n1 [label="[1] OTTO\n(10, 0, 1)"];
  n2 [label="[2] KLARA\n(20, 0, 2)"];
  n3 [label="[3] ศัตรู A ความเร็ว 3\n(10000, -3, 3)"];
  n4 [label="[4] ศัตรู B ความเร็ว 6\n(15, -6, 4)"];
  n5 [label="[5] ศัตรู C ความเร็ว 4\n(10000, -4, 5)"];
  n0 -> n1; n0 -> n2; n0 -> n3; n0 -> n4;
  n1 -> n5;
}
